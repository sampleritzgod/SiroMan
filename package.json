{
  "name": "siroman",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @stickyflow/web dev",
    "dev:api": "pnpm --filter @stickyflow/api dev",
    "db:deploy": "pnpm --filter @stickyflow/api db:deploy",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @stickyflow/api db:generate",
    "db:migrate": "pnpm --filter @stickyflow/api db:migrate",
    "db:push": "pnpm --filter @stickyflow/api db:push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0"
}
