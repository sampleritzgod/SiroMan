# TEMPLATE ONLY — do not put real secrets here.
# Copy values into:
#   apps/api/.env
#   apps/web/.env.local

# --- apps/api/.env ---
DATABASE_URL=postgresql://siroman:siroman@localhost:5432/siroman
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CLERK_SECRET_KEY=sk_test_replace_me

# Calendar sync (optional until Google OAuth is configured)
# TOKEN_ENCRYPTION_KEY: 32-byte secret as 64-char hex, base64, or long passphrase
TOKEN_ENCRYPTION_KEY=replace_with_long_random_secret_at_least_16_chars
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/integrations/google/callback

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
